# Copy this file to .env and adjust as needed. .env is git-ignored.

# When "1", retrieval/guards/LLM return canned values (see app/stub_data.py).
# Keep this "1" until the real components are integrated.
STUB_MODE=1

# Must be "0" for the demo and the final submission. When "1", the server
# honours the X-Guards header from the red-team harness for evaluation runs.
EVAL_MODE=0
