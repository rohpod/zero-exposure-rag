# Copy this file to .env and adjust as needed. .env is git-ignored.

# LLM provider: "mock" (offline, no key) or "groq".
LLM_PROVIDER=mock
# Model used by the groq provider (ignored by mock).
LLM_MODEL=qwen/qwen3.8-27b
# Groq API key; required when LLM_PROVIDER=groq. Never commit it.
GROQ_API_KEY=
# Maximum tokens generated per answer.
LLM_MAX_TOKENS=200
# Seconds before an LLM request times out.
LLM_TIMEOUT_S=30
# Mock behaviour: fixed, echo or leaky (leaky repeats everything it was given).
LLM_MOCK_MODE=fixed
# 1 caches LLM responses in data/cache/llm_cache.sqlite3 (use for evaluation runs).
LLM_CACHE=0
# Number of chunks retrieved per question.
RETRIEVAL_K=3
# 1 honours the X-Guards: off header from the red-team harness. Keep 0 for any demo.
EVAL_MODE=0
# 1 loads data/poisoned_documents.json into the corpus (needed for indirect-injection tests).
POISONED_CORPUS=0
# Auth tokens as a JSON string (overrides AUTH_TOKENS_FILE). Example from app/auth_tokens.example.json:
AUTH_TOKENS_JSON={"tok_support_01":{"user_id":"u_support_01","role":"support_agent"},"tok_support_02":{"user_id":"u_support_02","role":"support_agent"},"tok_fraud_01":{"user_id":"u_fraud_01","role":"fraud_analyst"},"tok_fraud_02":{"user_id":"u_fraud_02","role":"fraud_analyst"},"tok_compliance_01":{"user_id":"u_compliance_01","role":"compliance_officer"},"tok_compliance_02":{"user_id":"u_compliance_02","role":"compliance_officer"}}
# Path of a token file, used when AUTH_TOKENS_JSON is empty.
AUTH_TOKENS_FILE=app/auth_tokens.local.json
# SQLite audit database path.
AUDIT_DB_PATH=audit.sqlite3
# Port the server listens on inside Docker.
PORT=8000
